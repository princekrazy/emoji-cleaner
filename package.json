{
  "name": "emoji-cleaner",
  "displayName": "emoji-cleaner",
  "description": "Emoji Cleaner is a Visual Studio Code extension that enforces clean code standards by detecting and removing emoji characters from source files. It integrates directly into the editor workflow to support consistent, production-ready code formatting and improve code readability across projects.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "emoji-cleaner.cleanWholeFile",
        "title": "Remove Emojis: Whole File"
      },
      {
        "command": "emoji-cleaner.cleanSelection",
        "title": "Remove Emojis: Selection"
      },
      {
        "command": "emoji-cleaner.cleanLineRange",
        "title": "Remove Emojis: Line Range"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
