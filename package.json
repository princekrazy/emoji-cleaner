{
  "name": "emoji-sanitizer",
  "displayName": "Emoji Sanitizer",
  "description": "A Visual Studio Code extension that removes emoji characters from entire files, selected text, or specified line ranges.",
  "version": "1.0.0",
  "publisher": "princekrazy",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/princekrazy/emoji-cleaner"
  },
  "homepage": "https://github.com/princekrazy/emoji-cleaner",
  "bugs": {
    "url": "https://github.com/princekrazy/emoji-cleaner/issues"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "emoji-cleaner.cleanWholeFile",
        "title": "Remove Emojis: Whole File"
      },
      {
        "command": "emoji-cleaner.cleanSelection",
        "title": "Remove Emojis: Selection"
      },
      {
        "command": "emoji-cleaner.cleanLineRange",
        "title": "Remove Emojis: Line Range"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
